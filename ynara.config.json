{
  "$schema": "./docs/architecture/ynara-config.schema.json",
  "version": "0.1.0",
  "name": "ynara",
  "description": "Asistente personal adaptativo con memoria propia",
  "modes": {
    "productividad": {
      "model": "agente",
      "memory_layers": ["semantic", "episodic"],
      "tools_enabled": ["calendar", "reminder", "memory", "task"],
      "tone": "neutro-eficaz"
    },
    "estudio": {
      "model": "conversacional",
      "memory_layers": ["episodic", "procedural"],
      "tools_enabled": [],
      "tone": "encouragement"
    },
    "bienestar": {
      "model": "conversacional",
      "memory_layers": ["procedural", "semantic"],
      "tools_enabled": [],
      "tone": "casual-empatico"
    },
    "vida": {
      "model": "conversacional",
      "memory_layers": ["procedural"],
      "tools_enabled": [],
      "tone": "casual-rioplatense"
    },
    "memoria": {
      "model": "agente",
      "memory_layers": ["episodic", "semantic", "procedural"],
      "tools_enabled": ["memory"],
      "tone": "neutro-eficaz"
    }
  },
  "models": {
    "conversacional": {
      "role": "conversational",
      "writes_memory": false,
      "context_tokens": 8192
    },
    "agente": {
      "role": "agent",
      "writes_memory": true,
      "context_tokens": 32768
    }
  },
  "memory": {
    "engine": "in-house",
    "store": "postgres-pgvector",
    "embedding_model": "bge-m3",
    "consolidation": "celery-async",
    "decay_interval_days": 14,
    "decay_factor": 0.9,
    "stale_threshold": 0.3,
    "hard_delete_threshold": 0.1,
    "hard_delete_min_days": 90,
    "retention_default_days": 365,
    "retention_sensitive_days": 180,
    "retention_sensitive_min_days": 30,
    "retention_sensitive_max_days": 365,
    "episodic_retention_interval_days": 1
  },
  "infrastructure": {
    "phase": "mvp",
    "database": {
      "provider": "supabase",
      "type": "postgres-managed",
      "pgvector": true,
      "migration_target": "postgres-selfhosted-v2"
    },
    "cache": {
      "provider": "upstash-or-docker",
      "type": "redis"
    }
  }
}
